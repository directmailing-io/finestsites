{
  "cli": {
    "version": ">= 18.6.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_MOCK": "0" }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_MOCK": "0" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_MOCK": "0" },
      "ios": {
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6825371773",
        "appleTeamId": "PCVJR492G5"
      }
    }
  }
}
