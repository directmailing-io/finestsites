{
 "task": "transcribe",
 "language": "german",
 "duration": 88.896,
 "source": "Transkript Deutsch.srt (manuell)",
 "segments": [
  {
   "start": 0.0,
   "end": 1.0,
   "text": "Du gibst dir Mühe."
  },
  {
   "start": 1.34,
   "end": 5.2,
   "text": "Immer wieder trinkst du Smoothie, nimmst ein paar Vitamine zu dir,"
  },
  {
   "start": 5.42,
   "end": 7.64,
   "text": "vielleicht auch ein Eiweißshake nach dem Sport."
  },
  {
   "start": 8.08,
   "end": 10.72,
   "text": "Aber wo landet das eigentlich alles?"
  },
  {
   "start": 11.34,
   "end": 13.06,
   "text": "Komm, schau mal mit rein."
  },
  {
   "start": 13.76,
   "end": 15.0,
   "text": "Das hier ist dein Darm."
  },
  {
   "start": 15.08,
   "end": 18.44,
   "text": "Und alles, was du isst und trinkst, kommt zuerst hier vorbei."
  },
  {
   "start": 18.84,
   "end": 20.6,
   "text": "Im Idealfall läuft's so."
  },
  {
   "start": 20.82,
   "end": 23.96,
   "text": "Die Wände deines Darms sind voller winziger Härchen."
  },
  {
   "start": 24.34,
   "end": 25.66,
   "text": "Das sind die Darmzotten."
  },
  {
   "start": 26.24,
   "end": 28.22,
   "text": "Sie fangen die guten Nährstoffe ein"
  },
  {
   "start": 28.22,
   "end": 29.66,
   "text": "und reichen sie weiter."
  },
  {
   "start": 30.0,
   "end": 30.94,
   "text": "Ins Blut."
  },
  {
   "start": 31.2,
   "end": 32.62,
   "text": "Hinein in deine Zellen."
  },
  {
   "start": 32.94,
   "end": 35.98,
   "text": "Was nicht gebraucht wird, wandert ins Töpfchen."
  },
  {
   "start": 36.42,
   "end": 37.84,
   "text": "Aber jetzt kommt's."
  },
  {
   "start": 38.21,
   "end": 40.84,
   "text": "Mit der Zeit verkleben diese feinen Darmzotten"
  },
  {
   "start": 40.84,
   "end": 43.48,
   "text": "durch das, was wir täglich so zu uns nehmen."
  },
  {
   "start": 44.12,
   "end": 45.82,
   "text": "Pestizide vom Apfel."
  },
  {
   "start": 46.88,
   "end": 48.48,
   "text": "Konservierungsstoffe aus der Tüte."
  },
  {
   "start": 49.5,
   "end": 51.18,
   "text": "Plastikkrümel aus der Flasche."
  },
  {
   "start": 51.83,
   "end": 55.76,
   "text": "Und plötzlich rutschen selbst die guten Nährstoffe aus deinem Smoothie"
  },
  {
   "start": 55.76,
   "end": 58.24,
   "text": "oder deinen Vitaminen einfach durch."
  },
  {
   "start": 58.64,
   "end": 59.94,
   "text": "Direkt ins Töpfchen."
  },
  {
   "start": 60.66,
   "end": 63.24,
   "text": "Während ein paar von den unerwünschten Stoffen"
  },
  {
   "start": 63.24,
   "end": 65.34,
   "text": "trotzdem den Weg in deine Zellen finden."
  },
  {
   "start": 66.34,
   "end": 69.2,
   "text": "Kein Wunder, dass man da nicht ganz im Gleichgewicht ist."
  },
  {
   "start": 69.86,
   "end": 72.64,
   "text": "Genau hier setzen wir mit unserem Konzept an."
  },
  {
   "start": 73.18,
   "end": 77.0,
   "text": "Wie beim Zähneputzen möchten wir die Darmzotten wieder freilegen."
  },
  {
   "start": 77.1,
   "end": 79.96,
   "text": "Damit mehr von den guten Nährstoffen ankommt,"
  },
  {
   "start": 80.06,
   "end": 81.28,
   "text": "wo es hingehört."
  },
  {
   "start": 81.34,
   "end": 82.66,
   "text": "In deinen Zellen."
  },
  {
   "start": 83.26,
   "end": 85.38,
   "text": "Und du optimal versorgt wirst."
  }
 ]
}