[
 {
  "id": 0,
  "start": 0.0,
  "end": 1.0,
  "de": "Du gibst dir Mühe.",
  "text": "애쓰고 있죠."
 },
 {
  "id": 1,
  "start": 1.34,
  "end": 5.2,
  "de": "Immer wieder trinkst du Smoothie, nimmst ein paar Vitamine zu dir,",
  "text": "자주 스무디 마시고, 비타민도 좀 챙기고,"
 },
 {
  "id": 2,
  "start": 5.42,
  "end": 7.64,
  "de": "vielleicht auch ein Eiweißshake nach dem Sport.",
  "text": "운동 후엔 아마 프로틴 셰이크도."
 },
 {
  "id": 3,
  "start": 8.08,
  "end": 10.72,
  "de": "Aber wo landet das eigentlich alles?",
  "text": "근데 이게 다 어디로 갈까요?"
 },
 {
  "id": 4,
  "start": 11.34,
  "end": 13.06,
  "de": "Komm, schau mal mit rein.",
  "text": "자, 같이 봐요."
 },
 {
  "id": 5,
  "start": 13.76,
  "end": 15.0,
  "de": "Das hier ist dein Darm.",
  "text": "이게 장이에요."
 },
 {
  "id": 6,
  "start": 15.08,
  "end": 18.44,
  "de": "Und alles, was du isst und trinkst, kommt zuerst hier vorbei.",
  "text": "먹고 마시는 건 다 먼저 여길 지나가요."
 },
 {
  "id": 7,
  "start": 18.84,
  "end": 20.6,
  "de": "Im Idealfall läuft's so.",
  "text": "원래는 이래요."
 },
 {
  "id": 8,
  "start": 20.82,
  "end": 23.96,
  "de": "Die Wände deines Darms sind voller winziger Härchen.",
  "text": "장 벽엔 아주 작은 털들이 가득해요."
 },
 {
  "id": 9,
  "start": 24.34,
  "end": 25.66,
  "de": "Das sind die Darmzotten.",
  "text": "이게 장 융모예요."
 },
 {
  "id": 10,
  "start": 26.24,
  "end": 28.22,
  "de": "Sie fangen die guten Nährstoffe ein",
  "text": "좋은 영양소를 붙잡아서"
 },
 {
  "id": 11,
  "start": 28.22,
  "end": 29.66,
  "de": "und reichen sie weiter.",
  "text": "쭉 넘겨줘요."
 },
 {
  "id": 12,
  "start": 30.0,
  "end": 30.94,
  "de": "Ins Blut.",
  "text": "핏속으로."
 },
 {
  "id": 13,
  "start": 31.2,
  "end": 32.62,
  "de": "Hinein in deine Zellen.",
  "text": "그리고 세포 속으로."
 },
 {
  "id": 14,
  "start": 32.94,
  "end": 35.98,
  "de": "Was nicht gebraucht wird, wandert ins Töpfchen.",
  "text": "필요 없는 건 응가로 슝 나가요."
 },
 {
  "id": 15,
  "start": 36.42,
  "end": 37.84,
  "de": "Aber jetzt kommt's.",
  "text": "근데 있죠."
 },
 {
  "id": 16,
  "start": 38.21,
  "end": 40.84,
  "de": "Mit der Zeit verkleben diese feinen Darmzotten",
  "text": "시간이 흐르면 이 작은 장 융모가"
 },
 {
  "id": 17,
  "start": 40.84,
  "end": 43.48,
  "de": "durch das, was wir täglich so zu uns nehmen.",
  "text": "매일 먹는 것 때문에 엉겨 붙어요."
 },
 {
  "id": 18,
  "start": 44.12,
  "end": 45.82,
  "de": "Pestizide vom Apfel.",
  "text": "사과에 묻은 농약."
 },
 {
  "id": 19,
  "start": 46.88,
  "end": 48.48,
  "de": "Konservierungsstoffe aus der Tüte.",
  "text": "과자 봉지 속 방부제."
 },
 {
  "id": 20,
  "start": 49.5,
  "end": 51.18,
  "de": "Plastikkrümel aus der Flasche.",
  "text": "병 속 플라스틱 가루."
 },
 {
  "id": 21,
  "start": 51.83,
  "end": 55.76,
  "de": "Und plötzlich rutschen selbst die guten Nährstoffe aus deinem Smoothie",
  "text": "그러다 갑자기 스무디 속 좋은 영양소나"
 },
 {
  "id": 22,
  "start": 55.76,
  "end": 58.24,
  "de": "oder deinen Vitaminen einfach durch.",
  "text": "비타민까지 그냥 쓱 빠져나가요."
 },
 {
  "id": 23,
  "start": 58.64,
  "end": 59.94,
  "de": "Direkt ins Töpfchen.",
  "text": "곧장 응가로 슝."
 },
 {
  "id": 24,
  "start": 60.66,
  "end": 63.24,
  "de": "Während ein paar von den unerwünschten Stoffen",
  "text": "반면에 원치 않는 물질 몇 가지는"
 },
 {
  "id": 25,
  "start": 63.24,
  "end": 65.34,
  "de": "trotzdem den Weg in deine Zellen finden.",
  "text": "그래도 세포까지 들어가 버리죠."
 },
 {
  "id": 26,
  "start": 66.34,
  "end": 69.2,
  "de": "Kein Wunder, dass man da nicht ganz im Gleichgewicht ist.",
  "text": "몸 균형이 좀 흐트러질 만도 하죠."
 },
 {
  "id": 27,
  "start": 69.86,
  "end": 72.64,
  "de": "Genau hier setzen wir mit unserem Konzept an.",
  "text": "바로 여기서 저희 콘셉트가 시작돼요."
 },
 {
  "id": 28,
  "start": 73.18,
  "end": 77.0,
  "de": "Wie beim Zähneputzen möchten wir die Darmzotten wieder freilegen.",
  "text": "이를 닦듯이, 장 융모를 다시 드러내 주고 싶어요."
 },
 {
  "id": 29,
  "start": 77.1,
  "end": 79.96,
  "de": "Damit mehr von den guten Nährstoffen ankommt,",
  "text": "좋은 영양소가 더 많이 닿도록요,"
 },
 {
  "id": 30,
  "start": 80.06,
  "end": 81.28,
  "de": "wo es hingehört.",
  "text": "제자리에,"
 },
 {
  "id": 31,
  "start": 81.34,
  "end": 82.66,
  "de": "In deinen Zellen.",
  "text": "세포 속에요."
 },
 {
  "id": 32,
  "start": 83.26,
  "end": 85.38,
  "de": "Und du optimal versorgt wirst.",
  "text": "최적으로 채워지게요."
 }
]