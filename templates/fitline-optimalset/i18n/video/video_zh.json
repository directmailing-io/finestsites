[
 {
  "id": 0,
  "start": 0.0,
  "end": 1.0,
  "de": "Du gibst dir Mühe.",
  "text": "你很用心。"
 },
 {
  "id": 1,
  "start": 1.34,
  "end": 5.2,
  "de": "Immer wieder trinkst du Smoothie, nimmst ein paar Vitamine zu dir,",
  "text": "你时常喝杯果昔，再吃上那么几粒维生素，"
 },
 {
  "id": 2,
  "start": 5.42,
  "end": 7.64,
  "de": "vielleicht auch ein Eiweißshake nach dem Sport.",
  "text": "也许运动后喝一杯蛋白饮品。"
 },
 {
  "id": 3,
  "start": 8.08,
  "end": 10.72,
  "de": "Aber wo landet das eigentlich alles?",
  "text": "可这些到底都去哪儿了？"
 },
 {
  "id": 4,
  "start": 11.34,
  "end": 13.06,
  "de": "Komm, schau mal mit rein.",
  "text": "来，进去瞧瞧。"
 },
 {
  "id": 5,
  "start": 13.76,
  "end": 15.0,
  "de": "Das hier ist dein Darm.",
  "text": "这是你的肠道。"
 },
 {
  "id": 6,
  "start": 15.08,
  "end": 18.44,
  "de": "Und alles, was du isst und trinkst, kommt zuerst hier vorbei.",
  "text": "你吃的喝的，全都会先经过这里。"
 },
 {
  "id": 7,
  "start": 18.84,
  "end": 20.6,
  "de": "Im Idealfall läuft's so.",
  "text": "理想状态是这样。"
 },
 {
  "id": 8,
  "start": 20.82,
  "end": 23.96,
  "de": "Die Wände deines Darms sind voller winziger Härchen.",
  "text": "你的肠壁上长满了细细的小绒毛。"
 },
 {
  "id": 9,
  "start": 24.34,
  "end": 25.66,
  "de": "Das sind die Darmzotten.",
  "text": "这就是肠绒毛。"
 },
 {
  "id": 10,
  "start": 26.24,
  "end": 28.22,
  "de": "Sie fangen die guten Nährstoffe ein",
  "text": "它们抓住有益的营养素，"
 },
 {
  "id": 11,
  "start": 28.22,
  "end": 29.66,
  "de": "und reichen sie weiter.",
  "text": "再一路往下传。"
 },
 {
  "id": 12,
  "start": 30.0,
  "end": 30.94,
  "de": "Ins Blut.",
  "text": "进血液。"
 },
 {
  "id": 13,
  "start": 31.2,
  "end": 32.62,
  "de": "Hinein in deine Zellen.",
  "text": "再进到你的细胞里。"
 },
 {
  "id": 14,
  "start": 32.94,
  "end": 35.98,
  "de": "Was nicht gebraucht wird, wandert ins Töpfchen.",
  "text": "用不着的，就排出体外。"
 },
 {
  "id": 15,
  "start": 36.42,
  "end": 37.84,
  "de": "Aber jetzt kommt's.",
  "text": "关键来了。"
 },
 {
  "id": 16,
  "start": 38.21,
  "end": 40.84,
  "de": "Mit der Zeit verkleben diese feinen Darmzotten",
  "text": "时间一长，这些细细的肠绒毛"
 },
 {
  "id": 17,
  "start": 40.84,
  "end": 43.48,
  "de": "durch das, was wir täglich so zu uns nehmen.",
  "text": "会被我们每天吃的东西糊住。"
 },
 {
  "id": 18,
  "start": 44.12,
  "end": 45.82,
  "de": "Pestizide vom Apfel.",
  "text": "苹果上的农药。"
 },
 {
  "id": 19,
  "start": 46.88,
  "end": 48.48,
  "de": "Konservierungsstoffe aus der Tüte.",
  "text": "零食袋里的防腐剂。"
 },
 {
  "id": 20,
  "start": 49.5,
  "end": 51.18,
  "de": "Plastikkrümel aus der Flasche.",
  "text": "瓶子里的塑料碎屑。"
 },
 {
  "id": 21,
  "start": 51.83,
  "end": 55.76,
  "de": "Und plötzlich rutschen selbst die guten Nährstoffe aus deinem Smoothie",
  "text": "于是突然间，就连你果昔里有益的营养素，"
 },
 {
  "id": 22,
  "start": 55.76,
  "end": 58.24,
  "de": "oder deinen Vitaminen einfach durch.",
  "text": "或是维生素，也都白白溜走了，"
 },
 {
  "id": 23,
  "start": 58.64,
  "end": 59.94,
  "de": "Direkt ins Töpfchen.",
  "text": "直接排出体外。"
 },
 {
  "id": 24,
  "start": 60.66,
  "end": 63.24,
  "de": "Während ein paar von den unerwünschten Stoffen",
  "text": "而有一些不受欢迎的东西，"
 },
 {
  "id": 25,
  "start": 63.24,
  "end": 65.34,
  "de": "trotzdem den Weg in deine Zellen finden.",
  "text": "却还是钻进了你的细胞。"
 },
 {
  "id": 26,
  "start": 66.34,
  "end": 69.2,
  "de": "Kein Wunder, dass man da nicht ganz im Gleichgewicht ist.",
  "text": "难怪整个人会有点失去平衡。"
 },
 {
  "id": 27,
  "start": 69.86,
  "end": 72.64,
  "de": "Genau hier setzen wir mit unserem Konzept an.",
  "text": "我们的理念，正是从这里入手。"
 },
 {
  "id": 28,
  "start": 73.18,
  "end": 77.0,
  "de": "Wie beim Zähneputzen möchten wir die Darmzotten wieder freilegen.",
  "text": "就像刷牙一样，我们想让肠绒毛重新露出来。"
 },
 {
  "id": 29,
  "start": 77.1,
  "end": 79.96,
  "de": "Damit mehr von den guten Nährstoffen ankommt,",
  "text": "好让更多有益的营养素抵达"
 },
 {
  "id": 30,
  "start": 80.06,
  "end": 81.28,
  "de": "wo es hingehört.",
  "text": "该去的地方，"
 },
 {
  "id": 31,
  "start": 81.34,
  "end": 82.66,
  "de": "In deinen Zellen.",
  "text": "在你的细胞里，"
 },
 {
  "id": 32,
  "start": 83.26,
  "end": 85.38,
  "de": "Und du optimal versorgt wirst.",
  "text": "让身体获得所需营养。"
 }
]