[
 {
  "id": 0,
  "start": 0.0,
  "end": 1.0,
  "de": "Du gibst dir Mühe.",
  "text": "Çaba harcıyorsun."
 },
 {
  "id": 1,
  "start": 1.34,
  "end": 5.2,
  "de": "Immer wieder trinkst du Smoothie, nimmst ein paar Vitamine zu dir,",
  "text": "Sık sık smoothie içiyorsun, birkaç vitamin alıyorsun,"
 },
 {
  "id": 2,
  "start": 5.42,
  "end": 7.64,
  "de": "vielleicht auch ein Eiweißshake nach dem Sport.",
  "text": "belki spordan sonra bir de protein shake."
 },
 {
  "id": 3,
  "start": 8.08,
  "end": 10.72,
  "de": "Aber wo landet das eigentlich alles?",
  "text": "Peki bunlar aslında nereye gidiyor?"
 },
 {
  "id": 4,
  "start": 11.34,
  "end": 13.06,
  "de": "Komm, schau mal mit rein.",
  "text": "Gel, içeri bakalım."
 },
 {
  "id": 5,
  "start": 13.76,
  "end": 15.0,
  "de": "Das hier ist dein Darm.",
  "text": "Bu senin bağırsağın."
 },
 {
  "id": 6,
  "start": 15.08,
  "end": 18.44,
  "de": "Und alles, was du isst und trinkst, kommt zuerst hier vorbei.",
  "text": "Yediğin, içtiğin her şey önce buradan geçer."
 },
 {
  "id": 7,
  "start": 18.84,
  "end": 20.6,
  "de": "Im Idealfall läuft's so.",
  "text": "İdealde şöyle işler."
 },
 {
  "id": 8,
  "start": 20.82,
  "end": 23.96,
  "de": "Die Wände deines Darms sind voller winziger Härchen.",
  "text": "Bağırsağının duvarları minicik tüylerle dolu."
 },
 {
  "id": 9,
  "start": 24.34,
  "end": 25.66,
  "de": "Das sind die Darmzotten.",
  "text": "Bunlar bağırsak tüycükleri."
 },
 {
  "id": 10,
  "start": 26.24,
  "end": 28.22,
  "de": "Sie fangen die guten Nährstoffe ein",
  "text": "İyi besinleri yakalarlar"
 },
 {
  "id": 11,
  "start": 28.22,
  "end": 29.66,
  "de": "und reichen sie weiter.",
  "text": "ve onları aktarırlar."
 },
 {
  "id": 12,
  "start": 30.0,
  "end": 30.94,
  "de": "Ins Blut.",
  "text": "Kana."
 },
 {
  "id": 13,
  "start": 31.2,
  "end": 32.62,
  "de": "Hinein in deine Zellen.",
  "text": "Oradan hücrelerine."
 },
 {
  "id": 14,
  "start": 32.94,
  "end": 35.98,
  "de": "Was nicht gebraucht wird, wandert ins Töpfchen.",
  "text": "Gerekmeyenler de lazımlığa gider."
 },
 {
  "id": 15,
  "start": 36.42,
  "end": 37.84,
  "de": "Aber jetzt kommt's.",
  "text": "Ama şimdi sıkı dur."
 },
 {
  "id": 16,
  "start": 38.21,
  "end": 40.84,
  "de": "Mit der Zeit verkleben diese feinen Darmzotten",
  "text": "Zamanla bu ince bağırsak tüycükleri"
 },
 {
  "id": 17,
  "start": 40.84,
  "end": 43.48,
  "de": "durch das, was wir täglich so zu uns nehmen.",
  "text": "her gün aldıklarımızla yapış yapış olur."
 },
 {
  "id": 18,
  "start": 44.12,
  "end": 45.82,
  "de": "Pestizide vom Apfel.",
  "text": "Elmadaki tarım ilaçları."
 },
 {
  "id": 19,
  "start": 46.88,
  "end": 48.48,
  "de": "Konservierungsstoffe aus der Tüte.",
  "text": "Paketteki koruyucu maddeler."
 },
 {
  "id": 20,
  "start": 49.5,
  "end": 51.18,
  "de": "Plastikkrümel aus der Flasche.",
  "text": "Şişeden plastik kırıntılar."
 },
 {
  "id": 21,
  "start": 51.83,
  "end": 55.76,
  "de": "Und plötzlich rutschen selbst die guten Nährstoffe aus deinem Smoothie",
  "text": "Ve birden smoothie'ndeki iyi besinler bile"
 },
 {
  "id": 22,
  "start": 55.76,
  "end": 58.24,
  "de": "oder deinen Vitaminen einfach durch.",
  "text": "ya da vitaminlerin kayıp gider."
 },
 {
  "id": 23,
  "start": 58.64,
  "end": 59.94,
  "de": "Direkt ins Töpfchen.",
  "text": "Dosdoğru lazımlığa."
 },
 {
  "id": 24,
  "start": 60.66,
  "end": 63.24,
  "de": "Während ein paar von den unerwünschten Stoffen",
  "text": "O sırada istenmeyen bazı maddeler"
 },
 {
  "id": 25,
  "start": 63.24,
  "end": 65.34,
  "de": "trotzdem den Weg in deine Zellen finden.",
  "text": "yine de hücrelerine giden yolu bulur."
 },
 {
  "id": 26,
  "start": 66.34,
  "end": 69.2,
  "de": "Kein Wunder, dass man da nicht ganz im Gleichgewicht ist.",
  "text": "Tam dengede olmaman da şaşırtıcı değil."
 },
 {
  "id": 27,
  "start": 69.86,
  "end": 72.64,
  "de": "Genau hier setzen wir mit unserem Konzept an.",
  "text": "Tam burada konseptimiz devreye giriyor."
 },
 {
  "id": 28,
  "start": 73.18,
  "end": 77.0,
  "de": "Wie beim Zähneputzen möchten wir die Darmzotten wieder freilegen.",
  "text": "Diş fırçalar gibi, tüycükleri yeniden açmak istiyoruz."
 },
 {
  "id": 29,
  "start": 77.1,
  "end": 79.96,
  "de": "Damit mehr von den guten Nährstoffen ankommt,",
  "text": "Daha çok iyi besin ulaşsın diye,"
 },
 {
  "id": 30,
  "start": 80.06,
  "end": 81.28,
  "de": "wo es hingehört.",
  "text": "doğru yere."
 },
 {
  "id": 31,
  "start": 81.34,
  "end": 82.66,
  "de": "In deinen Zellen.",
  "text": "Hücrelerine."
 },
 {
  "id": 32,
  "start": 83.26,
  "end": 85.38,
  "de": "Und du optimal versorgt wirst.",
  "text": "Sen de optimal beslenesin."
 }
]