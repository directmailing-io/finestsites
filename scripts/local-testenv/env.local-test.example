# ─────────────────────────────────────────────────────────────────────────────
# Lokale Testumgebung – Umgebungsvariablen (Vorlage, wird committet).
#
# start.sh setzt genau diese Werte selbst; diese Datei dokumentiert sie nur.
# Echte Werte werden NIE hier eingetragen. start.sh liest aus
# /Users/kurzeja/new-finestsites/.env.local AUSSCHLIESSLICH:
#   STRIPE_TEST_SECRET_KEY, STRIPE_TEST_PUBLISHABLE_KEY, OPENAI_API_KEY
# und mappt die Stripe-TEST-Schlüssel auf STRIPE_SECRET_KEY /
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY. Alle anderen Variablen aus .env*-Dateien
# des Projekts werden beim Start leer überschrieben, damit Next.js sie nicht
# aus .env.local nachlädt.
# ─────────────────────────────────────────────────────────────────────────────

# Kennzeichnung der Umgebung (aktiviert src/lib/security/stripe-key-guard.ts)
FS_ENV=local
NODE_ENV=development

# Datenbank: nur die lokale, anonymisierte Kopie (setup.sh)
DATABASE_URL=postgresql://finestsites_dev:finestsites_dev_local@localhost:5432/finestsites_dev

# App / Auth (Port 3077; ohne BETTER_AUTH_URL → INVALID_ORIGIN beim Login)
BETTER_AUTH_URL=http://localhost:3077
NEXT_PUBLIC_APP_URL=http://localhost:3077
NEXT_PUBLIC_MARKETING_URL=http://localhost:3077
BETTER_AUTH_SECRET=local-test-only-not-a-secret-0123456789abcdef
ADMIN_EMAIL=admin@example.invalid
ADMIN_NOTIFY_EMAIL=admin@example.invalid

# Stripe: NUR Testmodus. Werte kommen aus STRIPE_TEST_* (siehe oben).
STRIPE_SECRET_KEY=<STRIPE_TEST_SECRET_KEY>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<STRIPE_TEST_PUBLISHABLE_KEY>
STRIPE_WEBHOOK_SECRET=whsec_local_dummy
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_local_dummy
# Preis-IDs: Live-Preise existieren im Testmodus nicht. Für Checkout-Tests
# Test-Preise im Stripe-Dashboard (Testmodus) anlegen und hier/als Env setzen:
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_UNLIMITED_MONTHLY=
STRIPE_PRICE_UNLIMITED_YEARLY=
STRIPE_AFFILIATE_COUPON_ID=
STRIPE_AFFILIATE_FIRST_MONTH_COUPON_ID=
STRIPE_AUTOMATIC_TAX=false

# E-Mail: absichtlich ungültig → es kann keine Mail rausgehen
RESEND_API_KEY=re_invalid_local_only
RESEND_FROM_EMAIL=noreply@example.invalid
MAILGUN_API_KEY=

# Cloudflare / Worker / R2: leer bzw. ins Nichts → kein Zugriff auf KV, R2,
# DNS oder Custom Hostnames der Produktion
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKERS_TOKEN=
CLOUDFLARE_KV_TOKEN=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_FINESTSITES_TOKEN=
CLOUDFLARE_FINESTSITES_DNS_TOKEN=
CLOUDFLARE_FALLBACK_HOST=
CLOUDFLARE_WORKER_SCRIPT=
CLOUDFLARE_R2_ENDPOINT=http://127.0.0.1:9
CLOUDFLARE_R2_ACCESS_KEY_ID=local-dummy
CLOUDFLARE_R2_SECRET_ACCESS_KEY=local-dummy
CLOUDFLARE_R2_BUCKET_NAME=local-dummy
WORKER_SECRET=local-worker-secret-dummy
CRON_SECRET=local-cron-secret-dummy
TRACKING_SECRET=local-tracking-secret-dummy-0123456789abcdef

# Sonstiges: leer
HETZNER_API_TOKEN=
EXPO_TOKEN=
SENTRY_DSN_SERVER=
SENTRY_DSN_APP=
SENTRY_ORG_TOKEN=
SENTRY_USER_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional (Support-KI-Vorschläge, ClaimGuard): aus .env.local übernommen
OPENAI_API_KEY=<OPENAI_API_KEY>
